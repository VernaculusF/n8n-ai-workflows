{
  "name": "01 Telegram AI Bot (Support) - Webhook+Poller",
  "id": "a6faedfd-5061-4e74-ac24-19ab2218a475",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "telegram",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "8c173d2c-39a8-48a2-8546-016d2e3cdcf8",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -600,
        0
      ],
      "webhookId": "a85e705e-a79f-47f4-b183-121603f310"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.body.message.text || $json.body.message.caption || '' }}",
        "options": {
          "systemMessage": "You are helpful support assistant. Answer concisely in Russian. One reply per message."
        }
      },
      "id": "12a8ef06-ef30-403c-acc2-4c1413f5a68a",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.8,
      "position": [
        -200,
        0
      ]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "inclusionai/ling-3.0-flash-fin:free"
        },
        "options": {}
      },
      "id": "7830353b-9eb1-4161-96b2-0f5f880da27a",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        -200,
        240
      ],
      "credentials": {
        "openAiApi": {
          "id": "2a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5e",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Webhook').item.json.body.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "75ab3151-e24e-4eef-a1ea-0447a4fb91e0",
      "name": "Telegram Send",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        200,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"ok\": true}",
        "options": {}
      },
      "id": "986349a9-9616-4140-8a47-0a6ff35ceb6d",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "sessionKey": "={{ $('Webhook').item.json.body.message.chat.id }}",
        "sessionIdType": "customKey",
        "contextWindowLength": 10
      },
      "id": "9acdcee4-c2a1-4bdc-b5b9-f48dc618339f",
      "name": "Window Buffer Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        -40,
        240
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Telegram Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram Send": {
      "main": [
        [
          {
