# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PostgreSQL (pgvector) - used by PGVector Store
# For host network (docker-compose.yml network_mode: host) use 127.0.0.1:5433, for bridge use postgres:5432
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=n8n_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Alternative explicit URL for tools that expect DATABASE_URL
DATABASE_URL=postgresql://n8n:n8n_password@postgres:5432/n8n

# Qdrant (optional vector store) — for host network use http://127.0.0.1:6333, for bridge http://qdrant:6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# Poller (Telegram long polling -> local webhook, no public HTTPS needed)
# Uses same TELEGRAM_BOT_TOKEN as n8n; set only if running poller.py as sidecar
# WEBHOOK_URL for poller is always http://localhost:5678/webhook/telegram (host network) or http://n8n:5678/webhook/telegram (bridge)

# n8n — WEBHOOK_URL must be public https:// for Telegram Trigger, http://localhost:5678/ for poller+Webhook mode
WEBHOOK_URL=http://localhost:5678/
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow
N8N_ENCRYPTION_KEY=replace-with-random-32-char-string
