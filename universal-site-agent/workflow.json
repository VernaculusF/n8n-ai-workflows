    {
      "parameters": {
        "jsCode": "const rows = $input.first().json.rows || $input.first().json || [];\nconst history = Array.isArray(rows) ? rows.reverse().map(r => `${r.role}: ${r.message}`).join('\\n') : '';\nconst cfg = $('Config Normalize').first().json;\nreturn [{json: {history, sanitizedMessage: cfg.sanitizedMessage, sessionId: cfg.sessionId, siteUrl: cfg.siteUrl, siteName: cfg.siteName, brandVoice: cfg.brandVoice, language: cfg.language}}];"
