    {
      "parameters": {
        "jsCode": "const duck = $input.first().json;\nconst agentOut = $('AI Agent').first()?.json?.output || '';\nconst query = $('Config Normalize').first().json.sanitizedMessage;\n// simple rerank: prefer duck AbstractText if present\nconst duckText = duck.AbstractText || duck.Results?.[0]?.Text || '';\nconst combined = agentOut + (duckText ? '\\n\\nFallback: ' + duckText : '');\nreturn [{json: {reranked: combined, duckText, agentOut, query}}];"
      },
      "id": "a1b2c3d4-0023-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "Code Rerank",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "let raw = $input.first().json.output || $input.first().json.reranked || $input.first().json.text || '';\nif (typeof raw !== 'string') raw = JSON.stringify(raw);\nlet data = {};\ntry {\n  const m = raw.match(/\\{[\\s\\S]*\\}/);\n  data = JSON.parse(m ? m[0] : raw);\n} catch(e) {\n  data = {answer: raw, confidence: 0.5, intent: 'answer', language: 'auto', needs_handoff: false, lead: {}, ticket: {}};\n}\nconst cfg = $('Config Normalize').first().json;\nconst sessionId = cfg.sessionId;\nconst siteUrl = cfg.siteUrl;\nreturn [{json: {raw, answer: String(data.answer||raw).slice(0,4000), confidence: Number(data.confidence||0.5), intent: String(data.intent||'answer'), language: String(data.language||'auto'), needs_handoff: Boolean(data.needs_handoff), lead: data.lead||{}, ticket: data.ticket||{}, sessionId, siteUrl, message: cfg.sanitizedMessage}}];"
      },
      "id": "a1b2c3d4-0024-4a7b-8c9d-0e1f2a3b4c5d",
