    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json || {};\nconst msg = body.message || body.text || body.query || body.input || '';\nconst sessionId = body.sessionId || body.session_id || body.chatId || body.chat_id || $json.headers?.['x-session-id'] || `sess_${Date.now()}_${Math.random().toString(36).slice(2,8)}`;\nconst siteUrl = $env.SITE_URL || body.siteUrl || 'https://example.com';\nconst siteName = $env.SITE_NAME || body.siteName || 'Universal Site';\nconst brandVoice = $env.BRAND_VOICE || 'helpful, concise, friendly';\nconst language = body.language || 'auto';\n// sanitize: trim, limit 4000 chars, strip control\nlet sanitizedMessage = String(msg).trim().slice(0,4000).replace(/\\x00/g,'');\nif (!sanitizedMessage) sanitizedMessage = 'Hello';\nreturn [{json: {message: msg, sanitizedMessage, sessionId, siteUrl, siteName, brandVoice, language, headers: $input.first().json.headers || {}, rawBody: body}}];"
      },
      "id": "a1b2c3d4-0002-4a7b-8c9d-0e1f2a3b4c5d",
