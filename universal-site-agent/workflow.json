        "query": "INSERT INTO chat_history (session_id, role, message, intent, confidence, language, needs_handoff, metadata) VALUES ('={{ $('Config Normalize').item.json.sessionId }}', 'assistant', '={{ $json.answer }}', '={{ $json.intent }}', {{ $json.confidence || 0.5 }}, '={{ $json.language }}', {{ $json.needs_handoff }}, '={{ JSON.stringify({siteUrl: $json.siteUrl, raw: $json.raw}) }}'::jsonb) RETURNING id; INSERT INTO chat_history (session_id, role, message) VALUES ('={{ $('Config Normalize').item.json.sessionId }}', 'user', '={{ $('Webhook Site Chat').item.json.body.message || $('Config Normalize').item.json.sanitizedMessage }}') RETURNING id;",
