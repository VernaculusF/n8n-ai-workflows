    {
      "parameters": {
        "jsCode": "const msg = $('Config Normalize').first().json.sanitizedMessage || '';\nconst blockedPatterns = [/ignore\\s+previous\\s+instructions/i, /system\\s+prompt/i, /\\bDROP\\s+TABLE\\b/i, /<script/i, /\\b prompt\\s+injection\\b/i];\nlet blocked = false, reason = '';\nfor (const re of blockedPatterns) { if (re.test(msg)) { blocked = true; reason = `blocked pattern ${re.source}`; break; } }\nif (msg.length > 4000) { blocked = true; reason = 'message too long'; }\nreturn [{json: {blocked, reason, sanitizedMessage: msg, sessionId: $('Config Normalize').first().json.sessionId, siteUrl: $('Config Normalize').first().json.siteUrl, siteName: $('Config Normalize').first().json.siteName, brandVoice: $('Config Normalize').first().json.brandVoice}}];"
      },
