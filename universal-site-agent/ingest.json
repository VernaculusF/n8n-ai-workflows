              "key": "text",
              "cssSelector": "body",
              "returnValue": "text",
              "trim": true,
              "rawData": false
            },
            {
              "key": "title",
              "cssSelector": "title",
              "returnValue": "text"
            }
          ]
        },
        "options": {
