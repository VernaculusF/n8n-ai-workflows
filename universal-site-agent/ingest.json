      "id": "b2c3d4e5-3333-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "Extract from File",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        -400,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $env.SITE_URL || $json.siteUrl || 'https://example.com' }}/sitemap.xml",
        "sendQuery": false,
        "options": {}
      },
      "id": "b2c3d4e5-4444-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "HTTP Request Sitemap",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -200,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const xml = $input.first().json.data || $input.first().json.body || '';\nconst urls = [];\nconst re = /<loc>([^<]+)<\\/loc>/g;\nlet m;\nwhile ((m = re.exec(xml)) !== null) urls.push({json: {url: m[1].trim(), source: 'sitemap'}});\nif (urls.length === 0) {\n  const site = ($env.SITE_URL || 'https://example.com').replace(/\\/$/, '');\n  urls.push({json: {url: site, source: 'fallback'}});\n}\nreturn urls.slice(0, 50);"
      },
      "id": "b2c3d4e5-5555-4a7b-8c9d-0e1f2a3b4c5d",
      "name": "Code Parse URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ]
    },
    {
