      "typeVersion": 4.2,
      "position": [
        200,
        0
      ]
    },
    {
      "parameters": {
        "operation": "extractHtmlContent",
        "sourceData": "={{ $json.data || $json.body }}",
        "extractionValues": {
          "values": [
